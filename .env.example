APP_NAME=Catalog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -------------------------
# Database
# -------------------------
# Default: SQLite (local development)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# PostgreSQL (for production)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=catalog_db
# DB_USERNAME=catalog_user
# DB_PASSWORD=secret

# -------------------------
# Cache / Session / Queue
# -------------------------
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# -------------------------
# Sanctum
# -------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# -------------------------
# Frontend
# -------------------------
VITE_APP_NAME="${APP_NAME}"
